import tkinter as tk
from tkinter import messagebox
def Sum(entry1, entry2):
    sum=entry1 + entry2
    return sum
def say_hello():
    messagebox.showinfo("Title", entry1.get() + "+" + entry2.get() + "=" + Sum(entry1.get(), entry2.get()) )
root=tk.Tk()
label=tk.Label(root,text="Enter 1st fraction:")
label.pack()
entry1 = tk.Entry(root)
entry1.pack()
label=tk.Label(root,text="Enter 2nd fraction:")
label.pack()
entry2 = tk.Entry(root)
entry2.pack()
button=tk.Button(root,text="Click me",command=say_hello)
button.pack()
root.geometry("1000x1000")
root.mainloop()