prices_list=[]
n=int(input("How many prices do you want to enter"))

for i in range(n):
    price=int(input(f"Enter price {i+1} :"))
    prices_list.append(price)

sum=sum(prices_list)
average=sum/n
highest=max(prices_list)
lowest=min(prices_list)

print("Count:",n)
print("Sum of Prices is:",sum)
print("Average of Prices:",average)
print("Highest:",highest)
print("Lowest:",lowest)

print("Highest to lowest range:")
for num in sorted(prices_list,reverse=True):
    print(num)
